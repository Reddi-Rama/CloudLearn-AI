function getActiveModule(pathname: string): string {
  const match = pathname.match(
    /\/lesson\/aiml\/generative-ai\/(module1|module2)(?:\/|$)/
  );

  return match?.[1] ?? "module1";
}

function isCurrentLesson(
  pathname: string,
  moduleId: string,
  lessonId: string
) {
  return pathname === `/lesson/aiml/generative-ai/${moduleId}/${lessonId}`;
}

function isCurrentUtility(
  pathname: string,
  moduleId: string,
  itemId: string
) {
  return pathname === `/lesson/aiml/generative-ai/${moduleId}/${itemId}`;
}

