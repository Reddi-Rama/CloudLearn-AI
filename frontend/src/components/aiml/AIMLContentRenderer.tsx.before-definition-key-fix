function FlowChart({ items }: { items: string[] }) {
  const cleanItems = items.filter(Boolean);
  const vertical = cleanItems.filter((x) => x !== "→").length >= 5;

  return (
    <div className="my-8 w-full min-w-0 overflow-hidden rounded-2xl border border-sky-500/20 bg-slate-950/40 p-4 sm:p-6">
      <div className={vertical ? "mx-auto flex max-w-3xl flex-col items-center" : "mx-auto flex w-full flex-wrap items-center justify-center gap-3 sm:gap-4"}>
        {cleanItems.map((item, index) => {
          if (item === "→") {
            return (
              <div key={`arrow-${index}`} className={vertical ? "flex h-9 items-center justify-center text-2xl font-bold text-sky-400" : "shrink-0 px-1 text-2xl font-bold text-sky-400"}>
                {vertical ? "↓" : "→"}
              </div>
            );
          }

          const isGroup = item.startsWith("[[") && item.endsWith("]]" );
          const groupItems = isGroup ? item.slice(2, -2).split("|").map((x) => x.trim()).filter(Boolean) : [];

          return (
            <div key={`node-${index}`} className={vertical ? "w-full max-w-2xl rounded-2xl border border-sky-500/30 bg-slate-900 px-5 py-4 text-center shadow-lg shadow-sky-950/10" : "min-h-[58px] min-w-[150px] max-w-[230px] rounded-2xl border border-sky-500/30 bg-slate-900 px-5 py-4 text-center shadow-lg shadow-sky-950/10"}>
              {isGroup ? (
                <div className="flex flex-wrap items-center justify-center gap-2">
                  {groupItems.map((groupItem) => (
                    <span key={groupItem} className="rounded-xl border border-cyan-400/20 bg-cyan-400/10 px-3 py-2 text-sm font-semibold text-cyan-200 sm:text-base">
                      {groupItem}
                    </span>
                  ))}
                </div>
              ) : (
                <span className="text-sm font-semibold leading-6 text-slate-100 sm:text-base">{renderMarkdownInline(item)}</span>
              )}
            </div>
          );
        })}
      </div>
    </div>
  );
}

function splitInlineFlow(text: string): string[] | null {
  const value = cleanLine(text);
  if (
    !value ||
    value.length > 180 ||
    value.includes("|") ||
    value.includes(";") ||
    value.startsWith("-") ||
    value.startsWith("#")
  ) {
    return null;
  }

  if (!/(?:→|⇒|⇢|➜|➝|->|=>)/.test(value)) return null;

  const parts = value
    .split(/\s*(?:→|⇒|⇢|➜|➝|->|=>)\s*/)
    .map((x) => x.trim())
    .filter(Boolean);

  if (parts.length < 2 || parts.some((x) => x.length > 70)) return null;

  const result: string[] = [];
  parts.forEach((part, index) => {
    if (index) result.push("→");
    result.push(part);
  });

  return result;
}

function isStandaloneArrow(text: string): boolean {
  return /^(?:→|↓|↑|←|⇒|⇢|➜|➝|->|=>)$/.test(cleanLine(text));
}

function looksLikeTerminal(line: string): boolean {
  const text = cleanLine(line);
  return (
    /^(?:python|python3|py)\s+-m\s+(?:venv|pip)\b/i.test(text) ||
    /^(?:pip|pip3)\s+(?:install|uninstall|show|freeze|list)\b/i.test(text) ||
    /^(?:npm|npx|node|yarn|pnpm)\s+/.test(text) ||
    /^(?:git|cd|mkdir|rmdir|dir|ls|pwd|echo|curl)\s+/.test(text) ||
    /^\.venv[\\/]Scripts[\\/]activate(?:\.bat|\.ps1)?$/i.test(text) ||
    /^source\s+.*activate$/.test(text) ||
    /^(?:conda|virtualenv)\s+/.test(text)
  );
}

function looksLikeFormulaAssignment(line: string): boolean {
  const text = cleanLine(line);
  const match = text.match(/^[A-Za-z_][A-Za-z0-9_]*\s*=\s*(.+)$/);
  if (!match) return false;

  const rhs = match[1];

  // Python multiplication/exponentiation such as x ** 2 is code, not a formula.
  if (/\*\*/.test(rhs)) return false;

  // Function calls, indexing, lists, dictionaries and statements indicate code.
  if (/[\[\]{};]/.test(rhs) || /\b[A-Za-z_]\w*\s*\(/.test(rhs)) return false;

  // A caret or mathematical variable/expression is a strong formula signal.
  return /\^/.test(rhs) || /(?:ŷ|ȳ|\by_hat\b|\by\b|\bx\b|\bz\b)/.test(rhs) && /[+\-*/]/.test(rhs);
}

function looksLikeCode(line: string): boolean {
  const text = cleanLine(line);
  if (!text || looksLikeTerminal(text) || looksLikeFormulaAssignment(text)) return false;

  return (
    /^from\s+\S+\s+import\s+/.test(text) ||
    /^import\s+/.test(text) ||
    /^(?:def|class)\s+\w+/.test(text) ||
    /^(?:if|elif|for|while|with|try|except|finally)\b.*:/.test(text) ||
    /^print\s*\(/.test(text) ||
    /^[A-Za-z_][A-Za-z0-9_]*\s*\*\*\s*(?:\d+(?:\.\d+)?|[A-Za-z_][A-Za-z0-9_]*)$/.test(text) ||
    /^return\b/.test(text) ||
    /^raise\b/.test(text) ||
    /^#include\s*[<"]/ .test(text) ||
    /^(?:int|float|double|char|bool|boolean|string|String|long|short)\s+\w+\s*(?:=|;)/.test(text) ||
    /^cout\s*<</.test(text) ||
    /^cin\s*>>/.test(text) ||
    /^(?:printf|scanf)\s*\(/.test(text) ||
    /^System\.out\./.test(text) ||
    /^\w+(?:\.\w+)*\s*\([^)]*\)\s*;?$/.test(text) ||
    /^\w+\s*=\s*(?:[\w.]+\s*\([^)]*\)|[\[\]{}`"']|\w+\s*(?:\*\*|%|\/\/)\s*\w+)/.test(text)
  );
}

function isExplicitCodeHeading(text: string): boolean {
  // Python is NOT automatically a code heading.
  // Some lessons use Python as one stage of a conceptual workflow.
  return /^(?:Python Example|Python Code):?$/i.test(cleanLine(text));
}

function isConceptualProcessNode(text: string): boolean {
  const value = cleanLine(text);
  if (!value || value.length > 90) return false;

  const known = /^(?:Data|Python|Python Code|Explanation|Numerical Computation|Data Processing|Mathematical Computation|Mathematical computation|Visualization|AI\s*\/\s*ML Algorithm|AI\s*\/\s*ML|Evaluation|Application|Observe|Observe Again|Interpret|Decide|Act|Sense|Perceive|Reason|Plan|Execute|Learn|Feedback|Information Processing|Reasoning(?: \/ Computation)?|Decision|Action|Processing|Environment|Agent|State|Update|Prediction|Output|Analysis|Jupyter Notebook|AI Data Workflow|AI Development Workflow|Training|Testing|Model|Deployment|Monitoring|Dependencies|Installation)$/i;

  if (known.test(value)) return true;

  if (/^(?:NumPy|Pandas|Matplotlib)(?:\s+(?:NumPy|Pandas|Matplotlib)){1,2}$/i.test(value)) return true;

  return false;
}

function isDiagramSyntaxLine(text: string): boolean {
  const value = cleanLine(text);
  if (!value) return true;

  return (
    /^[|│┌┐└┘├┤┬┴┼─━═╔╗╚╝╠╣╦╩╬]+$/.test(value) ||
    /^[↓↑→←⇒⇢➜➝|│\-_=+*]+$/.test(value) ||
    /[┌┐└┘├┤┬┴┼]/.test(value)
  );
}

function normalizeDiagramNode(text: string): string | null {
  const value = cleanLine(text);
  if (!value || isDiagramSyntaxLine(value) || isHorizontalRule(value)) return null;

  if (/^(?:NumPy|Pandas|Matplotlib)(?:\s+(?:NumPy|Pandas|Matplotlib)){1,2}$/i.test(value)) {
    const names = value.match(/NumPy|Pandas|Matplotlib/gi) || [];
    return `[[${Array.from(new Set(names)).join("|")}]]`;
  }

  return isConceptualProcessNode(value) ? value : null;
}

function tryBuildProcessFlow(lines: string[], index: number): { items: string[]; end: number } | null {
  const first = cleanLine(lines[index]);
  if (!isConceptualProcessNode(first)) return null;

  const items: string[] = [];
  let j = index;
  let sawConnector = false;
  let sawDiagramSyntax = false;
  let emptyAfterNode = false;

  while (j < lines.length && j < index + 16) {
    const text = cleanLine(lines[j]);

    if (!text) {
      if (items.length) { emptyAfterNode = true; j++; continue; }
      j++; continue;
    }

    if (isHorizontalRule(text)) { j++; continue; }

    // Mixed connector lines such as "→ AI Data Workflow → ---" are diagram syntax,
    // but the meaningful node in the middle should still be preserved.
    if (/[↓↑→←⇒⇢➜➝]/.test(text) && !isStandaloneArrow(text)) {
      const parts = text
        .split(/\s*(?:→|↓|↑|←|⇒|⇢|➜|➝|->|=>)\s*/)
        .map((part) => part.replace(/^-{3,}$/, "").trim())
        .filter(Boolean);

      let addedNode = false;
      for (const part of parts) {
        const node = normalizeDiagramNode(part);
        if (node) {
          items.push(node);
          addedNode = true;
        }
      }

      sawDiagramSyntax = true;
      sawConnector = true;
      if (addedNode) emptyAfterNode = false;
      j++;
      continue;
    }

    if (isDiagramSyntaxLine(text)) {
      sawDiagramSyntax = true;
      if (/[↓↑→←⇒⇢➜➝]/.test(text) || /\|/.test(text)) sawConnector = true;
      j++;
      continue;
    }

    const node = normalizeDiagramNode(text);
    if (node) {
      items.push(node);
      emptyAfterNode = false;
      j++;
      continue;
    }

    if (/^#{1,6}\s+/.test(text) || looksLikeCode(text) || /^(?:For example|Summary|Quick Check|Practice|Common Mistakes|Experiment|Dataset|Extended Study)$/i.test(text)) break;
    if (items.length && emptyAfterNode) break;
    break;
  }

  if (items.length >= 3 && (sawConnector || sawDiagramSyntax)) return { items, end: j };
  return null;
}

function isHorizontalRule(text: string): boolean {
  return /^(?:-{3,}|_{3,}|\*{3,})$/.test(cleanLine(text));
}

function looksLikeCodeBlockStart(lines: string[], index: number): boolean {
  const current = cleanLine(lines[index]);
  if (!looksLikeCode(current)) return false;

  // Avoid treating ordinary prose containing an assignment-like phrase as code.
  if (/^[A-Za-z][A-Za-z ]{0,35}\s*=\s*[A-Za-z ]+$/.test(current)) return false;
  return true;
}

function isMarkdownTableSeparator(line: string): boolean {
  const cells = cleanLine(line).replace(/^\|/, "").replace(/\|$/, "").split("|").map((x) => x.trim());
  return cells.length > 0 && cells.every((cell) => /^:?-{3,}:?$/.test(cell));
}

function isMarkdownTableRow(line: string): boolean {
  const text = cleanLine(line);
  return text.includes("|") && text.replace(/\|/g, "").trim().length > 0;
}

function splitTableRow(line: string): string[] {
  let text = cleanLine(line);
  if (text.startsWith("|")) text = text.slice(1);
  if (text.endsWith("|")) text = text.slice(0, -1);
  return text.split(/(?<!\\)\|/).map((x) => x.trim().replace(/\\\|/g, "|"));
}

function MarkdownTable({ lines }: { lines: string[] }) {
  if (lines.length < 2) return null;
  const header = splitTableRow(lines[0]);
  const separator = splitTableRow(lines[1]);
  const body = lines.slice(2).map(splitTableRow).filter((row) => row.some(Boolean));
  const count = Math.max(header.length, separator.length, ...body.map((r) => r.length));
  const getAlign = (cell: string) => cell.startsWith(":") && cell.endsWith(":") ? "text-center" : cell.endsWith(":") ? "text-right" : "text-left";

  return (
    <div className="my-8 w-full min-w-0 overflow-hidden rounded-2xl border border-slate-700 bg-slate-950 shadow-lg">
      <div className="w-full overflow-x-auto">
        <table className="w-full border-collapse text-left text-sm sm:text-base">
          <thead><tr className="bg-slate-800">
            {Array.from({ length: count }, (_, i) => <th key={i} className={`border-b border-slate-600 px-4 py-3 font-bold text-green-400 sm:px-6 sm:py-4 ${getAlign(separator[i] || "---")}`}>{header[i] || ""}</th>)}
          </tr></thead>
          <tbody>{body.map((row, ri) => <tr key={ri} className={ri % 2 ? "bg-slate-900/70" : "bg-slate-950"}>
            {Array.from({ length: count }, (_, ci) => <td key={ci} className={`border-b border-slate-800 px-4 py-3 text-slate-200 sm:px-6 sm:py-4 ${getAlign(separator[ci] || "---")}`}>{row[ci] || ""}</td>)}
          </tr>)}</tbody>
        </table>
      </div>
    </div>
  );
}

function sectionTone(title: string): Tone {
  const t = title.toLowerCase();
  if (t.includes("output") || t.includes("prediction") || t === "result") return "teal";
  if (t.includes("mistake") || t.includes("practice")) return "amber";
  if (t.includes("quick") || t.includes("question")) return "violet";
  if (t.includes("experiment") || t.includes("dataset")) return "rose";
  return "sky";
}

function isSpecialLabel(text: string): boolean {
  const t = cleanLine(text).replace(/^#{1,6}\s+/, "");
  return /^(?:Input|Expected Input|Output|Expected Output|Desired Output|Prediction|Process|How It Works|Steps|Model\s*\/\s*Process|Question|Answer|Code|Example|Key Takeaway|Common Mistakes|Summary|Quick Check|Experiment|Dataset|Extended Study|Explanation|Result|Mathematical Intuition|Real[- ]World Example)$/i.test(t);
}

function isBoundary(text: string): boolean {
  const t = cleanLine(text);
  return !t || /^#{1,6}\s+/.test(t) || isSpecialLabel(t);
}

function isIndented(line: string): boolean {
  return /^\s{4}|^\t/.test(line);
}

function renderMarkdownInline(text: string): React.ReactNode {
  const importantTerms = [
    "Accuracy",
    "Precision",
    "Recall",
    "F1-score",
    "F1 Score",
    "ROC-AUC",
    "PR-AUC",
    "MAE",
    "MSE",
    "RMSE",
    "R²",
    "Overfitting",
    "Underfitting",
    "Cross-Validation",
    "Regularization",
    "Classification",
    "Regression",
    "Clustering",
    "Feature Engineering",
    "Model Evaluation",
    "Hyperparameter",
    "Hyperparameters",
    "Precision-Recall",
    "Confusion Matrix",
    "Generalization",
    "Training Set",
    "Test Set",
    "Validation Set",
  ];

  const escaped = importantTerms
    .sort((a, b) => b.length - a.length)
    .map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
    .join("|");

const parts = text.split(
    new RegExp(`(\`[^\`]+\`|\\*\\*[^*]+\\*\\*|\\b(?:${escaped})\\b)`, "gi"),
  );

  return parts.map((part, index) => {
    if (part.startsWith("`") && part.endsWith("`")) {
      return (
        <code
          key={index}
          className="rounded-md bg-slate-800 px-1.5 py-0.5 font-mono text-[0.9em] text-cyan-300"
        >
          {part.slice(1, -1)}
        </code>
      );
    }

    if (part.startsWith("**") && part.endsWith("**")) {
      return (
        <strong key={index} className="font-bold text-white">
          {part.slice(2, -2)}
        </strong>
      );
    }

    const isImportant = importantTerms.some(
      (term) => term.toLowerCase() === part.toLowerCase(),
    );

    if (isImportant) {
      return (
        <strong
          key={index}
          className="font-semibold text-cyan-300"
        >
          {part}
        </strong>
      );
    }

    return <React.Fragment key={index}>{part}</React.Fragment>;
  });
}

function isCompactTerm(text: string): boolean {
  const value = cleanLine(text).replace(/[.!?]+$/, "");
  if (!value || value.length > 55) return false;

  return /^(?:Accuracy|Precision|Recall|F1(?:-score| Score)?|ROC-AUC|PR-AUC|MAE|MSE|RMSE|R²|Specificity|Sensitivity|Cross-Validation|Overfitting|Underfitting|Regularization|Generalization|Classification|Regression|Clustering|Feature Engineering|Confusion Matrix|Training Set|Validation Set|Test Set)$/i.test(value);
}

function CompactTermList({ terms }: { terms: string[] }) {
  return (
    <div className="my-4 grid w-full grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {terms.map((term, index) => (
        <div
          key={`${term}-${index}`}
          className="flex min-w-0 items-center gap-3 rounded-xl border border-slate-800/80 bg-slate-900/55 px-4 py-2.5 text-base leading-6 text-slate-200 transition-colors hover:border-cyan-500/30 hover:bg-slate-900/80 sm:text-[17px]"
        >
          <span className="h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-400" />
          <span>{renderMarkdownInline(term.replace(/[.!?]+$/, ""))}</span>
        </div>
      ))}
    </div>
  );
}

function prepareContent(value: string): string[] {
  const lines = value.replace(/\r\n/g, "\n").replace(/\r/g, "\n").split("\n");
  const result: string[] = [];
  let lessonTitlePending = false;

  for (let i = 0; i < lines.length; i++) {
    const raw = lines[i];
    const text = cleanLine(raw);

    if (/^Lesson\s+\d+$/i.test(text)) {
      result.push(text);
      lessonTitlePending = true;
      continue;
    }

    if (lessonTitlePending && text) {
      result.push(`# ${text}`);
      lessonTitlePending = false;
      continue;
    }

    // IMPORTANT: numbered lines are NOT automatically headings.
    // Only convert a numbered section when it is surrounded by blank lines.
    const numbered = text.match(/^(\d+)\.\s+(.+)$/);
    if (numbered) {
      const prev = i > 0 ? cleanLine(lines[i - 1]) : "";
      const next = i + 1 < lines.length ? cleanLine(lines[i + 1]) : "";
      const isSection = !prev && !next && numbered[2].length <= 110;
      result.push(isSection ? `## ${numbered[2]}` : raw);
      continue;
    }

    result.push(raw);
  }

  return result;
}

function getLessonVisualQuery(content: string): string {
  const lines = content.replace(/\r\n/g, "\n").replace(/\r/g, "\n").split("\n");

  for (let i = 0; i < lines.length; i++) {
    const value = cleanLine(lines[i]);
    if (!value) continue;

    if (/^Lesson\s+\d+$/i.test(value)) {
      for (let j = i + 1; j < lines.length; j++) {
        const title = cleanLine(lines[j]);
        if (title) return title;
      }
    }

    if (/^#{1,2}\s+/.test(value)) {
      return value.replace(/^#{1,2}\s+/, "");
    }
  }

  return "machine learning";
}

function renderContent(content: string): React.ReactNode[] {
  const lines = prepareContent(content);
  const elements: React.ReactNode[] = [];
  let i = 0;

  // One relevant live visual per lesson. The visual is enhancement-only and
  // never prevents the lesson itself from rendering if the image service fails.
  elements.push(
    <AIMLRealtimeVisual
      key="lesson-realtime-visual"
      query={getLessonVisualQuery(content)}
    />,
  );

  while (i < lines.length) {
    const raw = lines[i];
    const text = cleanLine(raw);

    if (!text) {
      // Blank lines are structural separators in the source content.
      // Do not turn every blank line into a large visible spacer.
      i++;
      continue;
    }

    // Markdown horizontal rules are formatting syntax, not lesson content.
    if (isHorizontalRule(text)) {
      i++;
      continue;
    }

    // Fenced code.
    if (text.startsWith("```")) {
      const language = text.slice(3).trim().replace(/^\+/, "");
      const code: string[] = [];
      i++;
      while (i < lines.length && !cleanLine(lines[i]).startsWith("```")) {
        code.push(lines[i]);
        i++;
      }
      if (i < lines.length) i++;
      elements.push(<CodeBlock key={`fenced-${i}`} lines={code} language={language || undefined} />);
      continue;
    }

    // Terminal / shell commands are code-like, but should be shown as terminal commands.
    if (looksLikeTerminal(text)) {
      const terminal: string[] = [raw];
      let j = i + 1;
      while (j < lines.length) {
        const t = cleanLine(lines[j]);
        if (!t) break;
        if (looksLikeTerminal(t)) {
          terminal.push(lines[j]);
          j++;
          continue;
        }
        break;
      }
      elements.push(<CodeBlock key={`terminal-${i}`} lines={terminal} language="terminal" />);
      i = j;
      continue;
    }

    // Conceptual workflow detection comes before Input/Output and code detection.
    // Labels such as Python, Output, Visualization and Analysis can be stages.
    const processFlow = tryBuildProcessFlow(lines, i);
    if (processFlow) {
      elements.push(
        <FlowChart
          key={`process-flow-${i}`}
          items={processFlow.items.flatMap((item, index) => index === processFlow.items.length - 1 ? [item] : [item, "→"])}
        />,
      );
      i = processFlow.end;
      continue;
    }

    // Input → Process → Output card.
    //
    // IMPORTANT:
    // Do not create an Input/Output component merely because the word
    // "Input" appears. Lessons also use Input/Output as conceptual
    // workflow stages. A real I/O card requires an explicit Process
    // section and an explicit Output section.
    if (/^(?:Input|Expected Input)$/i.test(text)) {
      let hasProcessSection = false;
      let hasOutputSection = false;
      let scan = i + 1;

      for (; scan < lines.length && scan < i + 40; scan++) {
        const t = cleanLine(lines[scan]);

        if (/^#{1,6}\s+/.test(t)) break;

        if (/^(?:Process|How It Works|Steps|Model\s*\/\s*Process)$/i.test(t)) {
          hasProcessSection = true;
        }

        if (/^(?:Output|Expected Output|Desired Output|Prediction)$/i.test(t)) {
          hasOutputSection = true;
          break;
        }

        // A new major conceptual section means this was not a structured I/O block.
        if (
          /^(?:Summary|Quick Check|Practice|Common Mistakes|Experiment|Dataset|Extended Study|Python|Code)$/i.test(t)
        ) {
          break;
        }
      }

      if (hasProcessSection && hasOutputSection) {
        const input: string[] = [];
        const process: string[] = [];
        const output: string[] = [];
        let section: "input" | "process" | "output" = "input";
        let j = i + 1;

        for (; j < lines.length; j++) {
          const t = cleanLine(lines[j]);

          if (!t) {
            if (section === "output" && output.length) break;
            continue;
          }

          if (/^#{1,6}\s+/.test(t)) break;

          if (/^(?:Process|How It Works|Steps|Model\s*\/\s*Process)$/i.test(t)) {
            section = "process";
            continue;
          }

          if (/^(?:Output|Expected Output|Desired Output|Prediction)$/i.test(t)) {
            section = "output";
            continue;
          }

          if (
            /^(?:Summary|Quick Check|Practice|Common Mistakes|Experiment|Dataset|Extended Study|Python|Code)$/i.test(t)
          ) {
            break;
          }

          if (section === "input") input.push(t);
          else if (section === "process") process.push(t);
          else output.push(t);
        }

        if (input.length || process.length || output.length) {
          elements.push(
            <AIMLInputOutput
              key={`io-${i}`}
              input={input}
              process={process}
              output={output}
            />,
          );
          i = j;
          continue;
        }
      }
    }

    // Output-only block.
    if (/^(?:Output|Expected Output|Desired Output|Prediction)$/i.test(text)) {
      let j = i + 1;
      while (j < lines.length && !cleanLine(lines[j])) j++;
      const next = j < lines.length ? cleanLine(lines[j]) : "";

      // A conceptual workflow such as "Output → Visualization → Analysis"
      // must remain a flow, not become an Output card.
      if (isConceptualProcessNode(next)) {
        // Let the process-flow parser handle it on the next iteration.
        i++;
        continue;
      }

      const output: string[] = [];
      for (; j < lines.length; j++) {
        const t = cleanLine(lines[j]);
        if (!t) break;
        if (/^#{1,6}\s+/.test(t) || isSpecialLabel(t)) break;
        output.push(t);
      }
      if (output.length) {
        elements.push(<OutputCard key={`output-${i}`} lines={output} title={text.replace(/:$/, "")} />);
        i = j;
        continue;
      }
    }

    // Question / answer block.
    if (/^Question:?$/i.test(text)) {
      const question: string[] = [];
      const answer: string[] = [];
      let mode: "q" | "a" = "q";
      let j = i + 1;
      for (; j < lines.length; j++) {
        const t = cleanLine(lines[j]);
        if (!t) { if (question.length || answer.length) break; continue; }
        if (/^Answer:?$/i.test(t)) { mode = "a"; continue; }
        if (/^#{1,6}\s+/.test(t) || isSpecialLabel(t) && !/^Answer:?$/i.test(t)) break;
        (mode === "q" ? question : answer).push(t);
      }
      if (question.length) {
        elements.push(<QuestionAnswerCard key={`qa-${i}`} question={question} answer={answer} />);
        i = j;
        continue;
      }
    }

    // Markdown table.
    if (isMarkdownTableRow(raw) && i + 1 < lines.length && isMarkdownTableSeparator(lines[i + 1])) {
      const table: string[] = [raw, lines[i + 1]];
      let j = i + 2;
      while (j < lines.length && cleanLine(lines[j]) && isMarkdownTableRow(lines[j])) { table.push(lines[j]); j++; }
      elements.push(<MarkdownTable key={`table-${i}`} lines={table} />);
      i = j;
      continue;
    }

    // Generic "Code" labels are sometimes used in conceptual lessons.
    // If the next meaningful line starts a process, ignore the label completely.
    if (/^(?:Code|Code Example):?$/i.test(text)) {
      let j = i + 1;
      while (j < lines.length && !cleanLine(lines[j])) j++;

      if (j < lines.length && isConceptualProcessNode(cleanLine(lines[j]))) {
        i++;
        continue;
      }
    }

    // Automatic code detection.
    // This catches real Python/C++/Java-like code even when the lesson
    // forgot to wrap it in Markdown fences.
    if (looksLikeCodeBlockStart(lines, i)) {
      const code: string[] = [];
      let j = i;

      while (j < lines.length) {
        const rawCode = lines[j];
        const t = cleanLine(rawCode);

        if (!t) {
          // Keep internal blank lines, but stop after a trailing blank line.
          if (code.length) code.push("");
          j++;
          if (j < lines.length && !cleanLine(lines[j])) break;
          continue;
        }

        if (
          j !== i &&
          (
            /^#{1,6}\s+/.test(t) ||
            isSpecialLabel(t) ||
            isHorizontalRule(t)
          )
        ) {
          break;
        }

        // Continue a code block when the line itself looks like code,
        // is indented, or is a common Python continuation.
        if (
          looksLikeCode(t) ||
          isIndented(rawCode) ||
          /^[)}\]]/.test(t) ||
          /^(?:else|elif|except|finally)\s*:/.test(t)
        ) {
          code.push(rawCode);
          j++;
          continue;
        }

        // A prose line ends an automatically detected code block.
        break;
      }

      while (code.length && !cleanLine(code[code.length - 1])) code.pop();

      if (code.length) {
        elements.push(
          <CodeBlock
            key={`auto-code-${i}`}
            lines={code}
            language={/^(?:from|import|def|class|if|elif|for|while|print|return)\b/.test(text) ? "python" : "code"}
          />,
        );
        i = j;
        continue;
      }
    }

    // Formula. This is deliberately checked BEFORE ordinary paragraph rendering,
    // but only for positively identified mathematical patterns.
    const formula = buildFormula(lines, i);
    if (formula) {
      elements.push(<FormulaCard key={`formula-${i}`} data={formula.data} />);
      i = formula.end + 1;
      continue;
    }

    // Inline flowchart.
    const inlineFlow = splitInlineFlow(text);
    if (inlineFlow) {
      elements.push(<FlowChart key={`inline-flow-${i}`} items={inlineFlow} />);
      i++;
      continue;
    }

    // Consecutive standalone flow nodes/arrows.
    if (isStandaloneArrow(text)) {
      const flow: string[] = [];
      let j = i;
      while (j < lines.length) {
        const t = cleanLine(lines[j]);
        if (!t) { j++; continue; }
        if (isStandaloneArrow(t)) { flow.push("→"); j++; continue; }
        if (flow.length && t.length <= 80 && !looksLikeCode(t) && !isBoundary(t)) { flow.push(t); j++; continue; }
        break;
      }
      if (flow.length > 1) {
        elements.push(<FlowChart key={`flow-${i}`} items={flow} />);
        i = j;
        continue;
      }
    }

    // Explicit Python section: consume until the next major section.
    // Generic "Code" is handled only when it is followed by actual code.
    if (isExplicitCodeHeading(text)) {
      const code: string[] = [];
      let j = i + 1;

      for (; j < lines.length; j++) {
        const t = cleanLine(lines[j]);
        if (
          /^#{1,6}\s+/.test(t) ||
          /^(?:Input|Output|Process|Question|Answer|Summary|Practice|Quick Check|Common Mistakes|Experiment|Dataset|Extended Study)$/i.test(t)
        ) {
          break;
        }
        code.push(lines[j]);
      }

      while (code.length && !cleanLine(code[code.length - 1])) code.pop();

      if (code.length) {
        elements.push(
          <SectionHeading
            key={`code-heading-${i}`}
            title={text.replace(/:$/, "")}
          />,
        );
        elements.push(
          <CodeBlock
            key={`section-code-${i}`}
            lines={code}
            language="python"
          />,
        );
      }

      i = j;
      continue;
    }

    // A plain "Python" label can mean either:
    // 1) a conceptual workflow stage, or
    // 2) a heading before actual Python source.
    // Only treat it as code when the following content really looks like code.
    if (/^Python:?$/i.test(text)) {
      let j = i + 1;
      while (j < lines.length && !cleanLine(lines[j])) j++;

      if (j < lines.length && looksLikeCodeBlockStart(lines, j)) {
        const code: string[] = [];
        let k = j;

        while (k < lines.length) {
          const rawCode = lines[k];
          const t = cleanLine(rawCode);

          if (!t) {
            if (code.length) code.push("");
            k++;
            if (k < lines.length && !cleanLine(lines[k])) break;
            continue;
          }

          if (k !== j && (/^#{1,6}\s+/.test(t) || isSpecialLabel(t) || isHorizontalRule(t))) {
            break;
          }

          if (looksLikeCode(t) || isIndented(rawCode) || /^[)}\]]/.test(t) || /^(?:else|elif|except|finally)\s*:/.test(t)) {
            code.push(rawCode);
            k++;
            continue;
          }

          break;
        }

        while (code.length && !cleanLine(code[code.length - 1])) code.pop();

        if (code.length) {
          elements.push(<SectionHeading key={`python-heading-${i}`} title="Python" />);
          elements.push(<CodeBlock key={`python-code-${i}`} lines={code} language="python" />);
          i = k;
          continue;
        }
      }
    }

    // Generic Code heading: only render it as code if the following content
    // is actually programming syntax. Otherwise it is just a source label.
    if (/^Code:?$/i.test(text)) {
      let j = i + 1;
      while (j < lines.length && !cleanLine(lines[j])) j++;

      if (j < lines.length && looksLikeCodeBlockStart(lines, j)) {
        const code: string[] = [];
        let k = j;

        while (k < lines.length) {
          const rawCode = lines[k];
          const t = cleanLine(rawCode);
          if (!t) {
            if (code.length) code.push("");
            k++;
            if (k < lines.length && !cleanLine(lines[k])) break;
            continue;
          }
          if (k !== j && (/^#{1,6}\s+/.test(t) || isSpecialLabel(t) || isHorizontalRule(t))) break;
          if (looksLikeCode(t) || isIndented(rawCode)) {
            code.push(rawCode);
            k++;
            continue;
          }
          break;
        }

        while (code.length && !cleanLine(code[code.length - 1])) code.pop();

        if (code.length) {
          elements.push(
            <SectionHeading key={`code-heading-${i}`} title="Code" />,
          );
          elements.push(
            <CodeBlock key={`section-code-${i}`} lines={code} language="code" />,
          );
          i = k;
          continue;
        }
      }

      i++;
      continue;
    }

    // Never display raw ASCII/box-drawing syntax from source content.
    if (isDiagramSyntaxLine(text)) {
      i++;
      continue;
    }

    // Markdown headings.
    if (text.startsWith("### ")) {
      elements.push(<h3 key={`h3-${i}`} className="mb-3 mt-6 max-w-full break-words rounded-xl border-l-4 border-teal-400 bg-teal-500/5 px-4 py-2 text-xl font-bold leading-tight text-teal-300 sm:text-2xl">{renderMarkdownInline(text.slice(4))}</h3>);
      i++; continue;
    }
    if (text.startsWith("## ")) {
      elements.push(<h2 key={`h2-${i}`} className="mb-4 mt-7 max-w-full break-words border-b border-violet-500/20 pb-3 text-2xl font-extrabold leading-tight text-violet-300 sm:text-3xl">{renderMarkdownInline(text.slice(3))}</h2>);
      i++; continue;
    }
    if (text.startsWith("# ")) {
      elements.push(<h1 key={`h1-${i}`} className="mb-5 max-w-full break-words rounded-2xl border border-sky-500/20 bg-sky-500/5 px-5 py-4 text-3xl font-extrabold leading-tight text-sky-300 sm:text-4xl">{renderMarkdownInline(text.slice(2))}</h1>);
      i++; continue;
    }

    // Special section headings.
    if (isSpecialLabel(text)) {
      const title = text.replace(/^#{1,6}\s+/, "").replace(/:$/, "");
      elements.push(<SectionHeading key={`section-${i}`} title={title} tone={sectionTone(title)} />);
      i++; continue;
    }

    // Bullets.
    const bullet = text.match(/^[-•*]\s+(.+)$/);
    if (bullet) {
      elements.push(
        <div key={`bullet-${i}`} className="mb-1.5 flex max-w-full min-w-0 items-start gap-3 text-base leading-7 text-gray-200 sm:gap-3 sm:text-lg sm:leading-7 lg:text-lg lg:leading-8">
          <span className="mt-3 h-2 w-2 shrink-0 rounded-full bg-sky-400 sm:mt-4 sm:h-2.5 sm:w-2.5" />
          <span>{renderMarkdownInline(bullet[1])}</span>
        </div>,
      );
      i++; continue;
    }

    // Numbered lists remain numbered lists. They are NEVER swallowed by formula logic.
    const numbered = text.match(/^(\d+)\.\s+(.+)$/);
    if (numbered) {
      elements.push(
        <div key={`number-${i}`} className="mb-1.5 flex max-w-full min-w-0 items-start gap-3 text-base leading-7 text-gray-200 sm:gap-3 sm:text-lg sm:leading-7 lg:text-lg lg:leading-8">
          <span className="min-w-[2rem] shrink-0 font-semibold text-sky-400">{numbered[1]}.</span>
          <span>{renderMarkdownInline(numbered[2])}</span>
        </div>,
      );
      i++; continue;
    }

    // Compact technical-term groups.
    // Lessons often store short important terms as separate lines with
    // blank lines between them. Keep them compact and visually distinct
    // instead of rendering each one as a full paragraph.
    if (isCompactTerm(text)) {
      const terms: string[] = [text];
      let j = i + 1;

      while (j < lines.length) {
        let k = j;
        while (k < lines.length && !cleanLine(lines[k])) k++;
        if (k >= lines.length) break;

        const candidate = cleanLine(lines[k]);
        if (!isCompactTerm(candidate)) break;
        terms.push(candidate);
        j = k + 1;
      }

      if (terms.length >= 3) {
        elements.push(<CompactTermList key={`terms-${i}`} terms={terms} />);
        i = j;
        continue;
      }
    }

    // Colon mini-heading.
    if (text.endsWith(":") && text.length <= 110 && !text.includes("://")) {
      elements.push(<h3 key={`mini-${i}`} className="mb-4 mt-7 max-w-full break-words text-xl font-extrabold text-teal-300 sm:text-2xl">{text.slice(0, -1)}</h3>);
      i++; continue;
    }

    // Indented lines outside an explicit code section are kept as readable text.
    // We intentionally do NOT automatically turn arbitrary indented prose into code.
    elements.push(<p key={`paragraph-${i}`} className="mb-3 max-w-full break-words text-base leading-7 text-gray-200 sm:text-lg sm:leading-7 lg:text-lg lg:leading-8">{renderMarkdownInline(isIndented(raw) ? raw.replace(/^\s{4}|^\t/, "") : text)}</p>);
    i++;
  }

  return elements;
}


/* ============================================================================
   ADVANCED AI FOUNDATIONS VISUAL INTELLIGENCE LAYER
   Keeps the existing text parser intact and adds semantic visual enhancement.
   ============================================================================ */

type AdvancedInsight = {
  label: string;
  value: string;
  tone: "cyan" | "violet" | "emerald" | "amber";
};

function getPlainLessonText(content: string): string {
  return content
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`[^`]*`/g, " ")
    .replace(/[#*_>|]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function detectLessonDomain(text: string): string {
  const t = text.toLowerCase();

  if (/\b(neural network|deep learning|cnn|rnn|lstm|transformer)\b/.test(t)) {
    return "Neural & Deep Learning";
  }

  if (/\b(regression|classification|clustering|supervised|unsupervised)\b/.test(t)) {
    return "Machine Learning";
  }

  if (/\b(agent|reasoning|planning|perception|search algorithm)\b/.test(t)) {
    return "Artificial Intelligence";
  }

  if (/\b(data|dataset|feature|preprocessing|visualization)\b/.test(t)) {
    return "AI Data & Computation";
  }

  return "Artificial Intelligence";
}

function detectDifficulty(text: string): "Foundation" | "Intermediate" | "Advanced" {
  const t = text.toLowerCase();

  let score = 0;

  if (/\b(matrix|vector|probability|variance|gradient|derivative|loss)\b/.test(t)) score += 1;
  if (/\b(backpropagation|optimization|regularization|hyperparameter)\b/.test(t)) score += 2;
  if (/\b(eigenvalue|eigenvector|bayesian|entropy|information gain)\b/.test(t)) score += 2;
  if (/\b(transformer|attention|embedding|convolution)\b/.test(t)) score += 2;

  if (score >= 4) return "Advanced";
  if (score >= 2) return "Intermediate";
  return "Foundation";
}

function detectContentSignals(text: string): AdvancedInsight[] {
  const lower = text.toLowerCase();

  const signals: AdvancedInsight[] = [];

  if (/\bexample\b|\bfor example\b/.test(lower)) {
    signals.push({
      label: "Examples",
      value: "Practical examples detected",
      tone: "cyan",
    });
  }

  if (/\binput\b[\s\S]*\boutput\b/.test(lower)) {
    signals.push({
      label: "Workflow",
      value: "Input / output relationship detected",
      tone: "emerald",
    });
  }

  if (/\bformula\b|\baccuracy\s*=|\bmse\s*=|\bmae\s*=|\brmse\s*=/.test(lower)) {
    signals.push({
      label: "Mathematics",
      value: "Mathematical reasoning detected",
      tone: "violet",
    });
  }

  if (/```|(?:^|\n)\s*(?:import|from|def|class|print|return|#include|cout|System\.out)/m.test(text)) {
    signals.push({
      label: "Code",
      value: "Executable code detected",
      tone: "cyan",
    });
  }

  if (/\bcommon mistakes?\b|\bpitfalls?\b|\bavoid\b/.test(lower)) {
    signals.push({
      label: "Pitfalls",
      value: "Common mistakes detected",
      tone: "amber",
    });
  }

  if (/\bsummary\b|\bkey takeaway\b|\bkey points?\b/.test(lower)) {
    signals.push({
      label: "Review",
      value: "Revision material detected",
      tone: "emerald",
    });
  }

  return signals.slice(0, 4);
}

function detectLearningMode(text: string): string {
  const lower = text.toLowerCase();

  if (/\bcode\b|```|python|c\+\+|java/.test(lower) && /\bexample\b/.test(lower)) {
    return "Concept + Implementation";
  }

  if (/\bformula\b|\bmathematical intuition\b|\bprobability\b|\bvariance\b/.test(lower)) {
    return "Concept + Mathematical Intuition";
  }

  if (/\bprocess\b|\bsteps\b|\bworkflow\b|\barchitecture\b/.test(lower)) {
    return "Concept + Process Visualization";
  }

  if (/\bclassification\b|\btypes\b|\bcategories\b|\bkind\b/.test(lower)) {
    return "Concept + Classification";
  }

  return "Conceptual Learning";
}

function AdvancedLessonHeader({ content }: { content: string }) {
  const plain = getPlainLessonText(content);
  const domain = detectLessonDomain(plain);
  const difficulty = detectDifficulty(plain);
  const mode = detectLearningMode(plain);

  const titleMatch =
    content.match(/^\s*Lesson\s+\d+\s*[\r\n]+([^\r\n]+)/im) ||
    content.match(/^\s*#{1,2}\s+([^\r\n]+)/m);

  const title = titleMatch?.[1]?.trim();

  return (
    <section className="mb-8 overflow-hidden rounded-[28px] border border-cyan-500/20 bg-gradient-to-br from-[#071525] via-[#091322] to-[#0d1020] shadow-[0_20px_70px_rgba(8,145,178,0.08)]">
      <div className="relative overflow-hidden px-6 py-7 sm:px-8 sm:py-9">
        <div className="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-cyan-500/10 blur-3xl" />
        <div className="pointer-events-none absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-violet-500/10 blur-3xl" />

        <div className="relative">
          <div className="mb-4 flex flex-wrap items-center gap-2">
            <span className="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-[10px] font-black uppercase tracking-[0.18em] text-cyan-300">
              AI Foundations
            </span>
            <span className="rounded-full border border-violet-400/20 bg-violet-400/10 px-3 py-1 text-[10px] font-black uppercase tracking-[0.18em] text-violet-300">
              {domain}
            </span>
          </div>

          {title && (
            <h2 className="max-w-4xl text-2xl font-black leading-tight text-white sm:text-3xl lg:text-4xl">
              {title.replace(/^Lesson\s+\d+\s*/i, "")}
            </h2>
          )}

          <div className="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
            {[
              ["Level", difficulty],
              ["Learning Mode", mode],
              ["Content Engine", "Adaptive visual parsing"],
            ].map(([label, value]) => (
              <div
                key={label}
                className="rounded-2xl border border-slate-800/80 bg-slate-950/50 px-4 py-3"
              >
                <div className="text-[10px] font-black uppercase tracking-[0.16em] text-slate-500">
                  {label}
                </div>
                <div className="mt-1 text-sm font-bold text-slate-200">
                  {value}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  );
}

function AdvancedInsightPanel({ content }: { content: string }) {
  const plain = getPlainLessonText(content);
  const signals = detectContentSignals(plain);

  if (!signals.length) return null;

  const toneClasses = {
    cyan: "border-cyan-500/20 bg-cyan-500/[0.05] text-cyan-300",
    violet: "border-violet-500/20 bg-violet-500/[0.05] text-violet-300",
    emerald: "border-emerald-500/20 bg-emerald-500/[0.05] text-emerald-300",
    amber: "border-amber-500/20 bg-amber-500/[0.05] text-amber-300",
  };

  return (
    <section className="mb-8 rounded-[24px] border border-slate-800 bg-slate-950/60 p-5 sm:p-6">
      <div className="mb-4">
        <div className="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">
          Lesson Intelligence
        </div>
        <div className="mt-1 text-lg font-bold text-white">
          What this lesson contains
        </div>
      </div>

      <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {signals.map((signal) => (
          <div
            key={signal.label}
            className={`rounded-2xl border px-4 py-4 ${toneClasses[signal.tone]}`}
          >
            <div className="text-xs font-black uppercase tracking-[0.14em]">
              {signal.label}
            </div>
            <div className="mt-1 text-sm leading-6 text-slate-300">
              {signal.value}
            </div>
          </div>
        ))}
      </div>
    </section>
  );
}

function AdvancedConceptMap({ content }: { content: string }) {
  const lines = content
    .replace(/\r\n/g, "\n")
    .split("\n")
    .map(cleanLine)
    .filter(Boolean);

  const candidates = lines
    .filter((line) => {
      if (line.length < 3 || line.length > 65) return false;
      if (/^#{1,6}\s/.test(line)) return false;
      if (/^[-*?]\s/.test(line)) return false;
      if (/^\d+\.\s/.test(line)) return false;
      if (looksLikeCode(line)) return false;
      if (looksMathematical(line)) return false;
      if (isSpecialLabel(line)) return false;
      return /^[A-Z][A-Za-z0-9/& -]+$/.test(line);
    })
    .slice(0, 6);

  if (candidates.length < 3) return null;

  return (
    <section className="my-8 overflow-hidden rounded-[26px] border border-violet-500/20 bg-gradient-to-br from-violet-950/20 via-slate-950 to-slate-950 p-5 sm:p-7">
      <div className="mb-6">
        <div className="text-[10px] font-black uppercase tracking-[0.2em] text-violet-400">
          Concept Map
        </div>
        <h3 className="mt-1 text-xl font-black text-white sm:text-2xl">
          Core ideas in this lesson
        </h3>
      </div>

      <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {candidates.map((item, index) => (
          <div
            key={`${item}-${index}`}
            className="relative rounded-2xl border border-slate-800 bg-slate-900/80 px-5 py-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-violet-500/40"
          >
            <div className="mb-3 flex h-8 w-8 items-center justify-center rounded-xl bg-violet-500/10 text-xs font-black text-violet-300">
              {String(index + 1).padStart(2, "0")}
            </div>
            <div className="font-semibold leading-6 text-slate-100">
              {renderMarkdownInline(item)}
            </div>
          </div>
        ))}
      </div>
    </section>
  );
}

function AdvancedDefinitionCards({ content }: { content: string }) {
  const lines = content
    .replace(/\r\n/g, "\n")
    .split("\n")
    .map(cleanLine);

  const definitions: Array<{ term: string; meaning: string }> = [];

  for (const line of lines) {
    const match =
      line.match(/^([A-Za-z][A-Za-z0-9 ()/&-]{1,45})\s*:\s+(.{15,220})$/) ||
      line.match(/^([A-Za-z][A-Za-z0-9 ()/&-]{1,45})\s+means\s+(.{15,220})$/i) ||
      line.match(/^([A-Za-z][A-Za-z0-9 ()/&-]{1,45})\s+is\s+(.{15,220})$/i);

    if (!match) continue;

    if (
      isSpecialLabel(match[1]) ||
      looksLikeCode(line) ||
      looksMathematical(line)
    ) {
      continue;
    }

    definitions.push({
      term: match[1].trim(),
      meaning: match[2].trim(),
    });

    if (definitions.length >= 4) break;
  }

  if (definitions.length < 2) return null;

  return (
    <section className="my-8">
      <div className="mb-4 flex items-end justify-between gap-4">
        <div>
          <div className="text-[10px] font-black uppercase tracking-[0.2em] text-cyan-400">
            Knowledge Cards
          </div>
          <h3 className="mt-1 text-xl font-black text-white sm:text-2xl">
            Important definitions
          </h3>
        </div>
      </div>

      <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
        {definitions.map((item) => (
          <div
            key={item.term}
            className="rounded-2xl border border-cyan-500/15 bg-slate-950/70 p-5"
          >
            <div className="mb-2 text-base font-black text-cyan-300">
              {item.term}
            </div>
            <p className="text-sm leading-7 text-slate-300">
              {renderMarkdownInline(item.meaning)}
            </p>
          </div>
        ))}
      </div>
    </section>
  );
}

function AdvancedReviewStrip({ content }: { content: string }) {
  const plain = getPlainLessonText(content);
  const sentences = plain
    .split(/(?<=[.!?])\s+/)
    .map((x) => x.trim())
    .filter((x) => x.length >= 45 && x.length <= 180);

  const important = sentences
    .filter((sentence) =>
      /\b(is|means|refers to|because|therefore|important|used to|allows|helps|consists of)\b/i.test(sentence)
    )
    .slice(0, 3);

  if (important.length < 2) return null;

  return (
    <section className="my-9 rounded-[26px] border border-emerald-500/20 bg-emerald-950/10 p-5 sm:p-7">
      <div className="mb-5">
        <div className="text-[10px] font-black uppercase tracking-[0.2em] text-emerald-400">
          Exam Focus
        </div>
        <h3 className="mt-1 text-xl font-black text-white sm:text-2xl">
          Concepts worth remembering
        </h3>
      </div>

      <div className="space-y-3">
        {important.map((sentence, index) => (
          <div
            key={index}
            className="flex gap-3 rounded-2xl border border-emerald-500/10 bg-slate-950/50 p-4"
          >
            <span className="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-xs font-black text-emerald-300">
              {index + 1}
            </span>
            <p className="text-sm leading-7 text-slate-300">
              {renderMarkdownInline(sentence)}
            </p>
          </div>
        ))}
      </div>
    </section>
  );
}

function AIMLAdvancedVisualLayer({ content }: { content: string }) {
  return (
    <>
      <AdvancedLessonHeader content={content} />
      <AdvancedInsightPanel content={content} />
      <AdvancedDefinitionCards content={content} />
      <AdvancedConceptMap content={content} />
    </>
  );
}


export default function AIMLContentRenderer({ content }: { content: unknown }) {
  let value = "";

  if (typeof content === "string") {
    value = content;
  } else if (content && typeof content === "object" && "content" in content) {
    value = String((content as { content?: unknown }).content ?? "");
  }

  if (!value.trim()) {
    return (
      <div className="rounded-2xl border border-slate-800 bg-slate-950/70 p-6 text-slate-400">
        No lesson content is available.
      </div>
    );
  }

  return (
    <div className="w-full min-w-0 max-w-full overflow-visible break-words [overflow-wrap:anywhere] [&_img]:max-w-full [&_pre]:max-w-full [&_table]:max-w-full">
      <AIMLAdvancedVisualLayer content={value} />
      {renderContent(value)}
      <AdvancedReviewStrip content={value} />
    </div>
  );
}

